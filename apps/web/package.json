{
  "name": "web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "deploy": "vite build && vinext-cloudflare deploy --config dist/server/wrangler.json",
    "typecheck": "tsc -p .",
    "deploy:staging": "CLOUDFLARE_ENV=staging vite build && vinext-cloudflare deploy --skip-build --config dist/server/wrangler.json"
  },
  "dependencies": {
    "@kitelog/shared": "workspace:*",
    "@vinext/cloudflare": "^1.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-server-dom-webpack": "^19.3.0",
    "uplot": "^1.6.32",
    "vinext": "^1.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-rsc": "^0.5.36",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.3",
    "wrangler": "^4.148.0"
  }
}
